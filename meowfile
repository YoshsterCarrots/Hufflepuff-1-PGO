	CCFLAGS= DBFLAGS
	a.out

PGOProfile.out:
	CCFLAGS= ProfGenFLAGS
	a.out

PGOUse.out:
	CCFLAGS= ProfFLAGS
	a.out

A_Bench.out:
	CCFLAGS= AFLAGS
	a.out

B_Bench.out:
	CCFLAGS= BFLAGS
	a.out

C_Bench.out:
	CCFLAGS= CFLAGS
	a.out

D_Bench.out:
	CCFLAGS= DFLAGS
	a.out

E_Bench.out:
	CCFLAGS= EFLAGS
	a.out

F_Bench.out:
	CCFLAGS= FFLAGS
	a.out

G_Bench.out:
	CCFLAGS= GFLAGS
	a.out

main.o: main.cc
	g++ $(CCFLAGS) -c main.cc

SortedCompilation.o: SortedCompilation.cc SortedCompilation.h Compilation.o Video.o
	g++ $(CCFLAGS) -c SortedCompilation.h SortedCompilation.cc

Compilation.o: Compilation.cc Compilation.h Video.o
